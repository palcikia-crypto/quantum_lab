PERIODS = [("4H", 14400)]  # Пример периодов (название, длительность в секундах)
PAIRS = ["BTC/USD", "ETH/USD"]  # Пример торговых пар

def main():
    log('=== AUTO EVOLVE BY REGIME ===')
    muts = generate_mutants()
    # 50 стратегий: все vwap, ema, grid, macd
    all_muts = {k: v for k, v in muts.items() if any(x in k for x in ['vwap', 'ema', 'grid_sma', 'macd'])}
    log(f'Стратегий (50): {len(all_muts)}')

    now = int(time.time())
    results = {'flat': defaultdict(dict), 'trend': defaultdict(dict)}

    for p_name, p_sec in PERIODS:
        start_ts = now - p_sec
        for sym in PAIRS:
            data = load_candles(sym, start_ts, now)
            if not data: continue
            for strat_name, strat_fn in all_muts.items():
                try:
                    up, dn = strat_fn(data['o'], data['h'], data['l'], data['c'], data['v'], {})
                except Exception as e:
                    log(f"Error in strategy {strat_name}: {e}")
                    continue

                # Flat
                trades = sim_trades_regime(up, dn, data['o'], data['h'], data['l'], data['c'], data['ts'], 'flat')
                if trades:
