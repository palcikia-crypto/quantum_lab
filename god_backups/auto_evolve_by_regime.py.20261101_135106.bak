import sqlite3

MARKET_DB = 'your_database_file.db'  # Замените на имя вашей базы данных

def load_candles(sym, start_ts, end_ts, tf='15m'):
    c = sqlite3.connect(MARKET_DB, timeout=30)
    rows = c.execute("""SELECT ts, o, h, l, c, v FROM candles
                        WHERE symbol=? AND tf=? AND ts>=? AND ts<? ORDER BY ts""",
                     (sym, tf, start_ts, end_ts)).fetchall()
    c.close()

    if not rows:
        return None

    return {k: [r[i] for r in rows] for i, k in enumerate(['ts', 'o', 'h', 'l', 'c', 'v'])}

def calc_adx_at(data, idx):
    """ADX на индексе idx (упрощённо)."""
    if idx < 50: return 0
    c = data['c'][:idx+1]
    h = data['h'][:idx+1]
    l = data['l'][:idx+1]
    plus_dm = np.maximum(np.diff(h), 0)
    minus_dm = np.maximum(-np.diff(l), 0)
    tr = np.maximum(h[1:] - l[1:], np.maximum(np.abs(h[1:] - c[:-1]), np.abs(l[1:] - c[:-1])))
    if len(tr) < 14: return 0
    plus_di = 100 * np.mean(plus_dm[-14:]) / (np.mean(tr[-14:]) + 1e-9)
    minus_di = 100 * np.mean(minus_dm[-14:]) / (np.mean(tr[-14:]) + 1e-9)
    dx = 100 * np.abs(plus_di - minus_di) / (plus_di + minus_di + 1e-9)
    return dx

def sim_trades_regime(up, dn, o, h, l, c, ts, regime_filter='flat', adx_threshold=25, tp=TP, sl=SL, timeout=TIMEOUT, start=50):
    """Симуляция с фильтром по режиму."""
    trades = []
    n = len(c)
    if n < start+2: return trades
    i = start; last_i = -1
    # Предвычисляем ADX для каждого бара
    adx_arr = np.zeros(n)
    for k in range(start, n):
        adx_arr[k] = calc_adx_at({'c': c, 'h': h, 'l': l}, k)

    while i < n - 1:
        if i <= last_i: i += 1; continue
        # Фильтр по режиму
        is_flat = adx_arr[i] < adx_threshold
        if regime_filter == 'flat' and not is_flat: i += 1; continue
        if regime_filter == 'trend' and is_flat: i += 1; continue

        side = None
        if up[i]: side = 'LONG'
        elif dn[i]: side = 'SHORT'
        if not side: i += 1; continue
        entry = c[i]
        tp_p = entry*(1+tp) if side=='LONG' else entry*(1-tp)
        sl_p = entry*(1-sl) if side=='LONG' else entry*(1+sl)
        end = min(i+1+timeout, n); exit_p = None
        for j in range(i+1, end):
            if side == 'LONG':
                if l[j] <= sl_p: exit_p = sl_p; break
                if h[j] >= tp_p: exit_p = tp_p; break
            else:
                if h[j] >= sl_p: exit_p = sl_p; break
                if l[j] <= tp_p: exit_p = tp_p; break
        if exit_p is None:
            jj = min(i+timeout, n-1); exit_p = c[jj]; last_i = jj
        else:
            last_i = i
        move = (exit_p - entry)/entry if side=='LONG' else (entry - exit_p)/entry
        pnl = (move - FEE) * 100
        trades.append({'pnl': float(pnl)})
        i += 1
    return trades

