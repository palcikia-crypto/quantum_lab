from datetime import datetime

LOG = 'log.txt'  # Убедитесь, что этот путь корректен и файл доступен для записи

def log(m):
    line = f'[{datetime.now():%H:%M:%S}] {m}'
    print(line, flush=True)
    try:
        with open(LOG, 'a') as f:
            f.write(line + '\n')
    except Exception as e:
        print(f"Ошибка при записи в лог: {e}", flush=True)

import sqlite3

MARKET_DB = 'path_to_your_database.db'  # Замените на путь к вашей базе данных

def load_candles(sym, start_ts, end_ts, tf='15m'):
    c = sqlite3.connect(MARKET_DB, timeout=30)
    rows = c.execute("""SELECT ts, o, h, l, c, v FROM candles
                        WHERE symbol=? AND tf=? AND ts>=? AND ts<? ORDER BY ts""",
                     (sym, tf, start_ts, end_ts)).fetchall()
    c.close()

    if not rows:
        return None

    # Исправление: правильное создание словаря
    return {k: [r[i] for r in rows] for i, k in enumerate(['ts', 'o', 'h', 'l', 'c', 'v'])}

import sqlite3

OB_DB = 'path_to_your_database.db'  # Замените на путь к вашей базе данных

def load_obi(sym, start_ts, end_ts):
    sym_dash = sym[:-4] + '-USDT' if sym.endswith('USDT') else sym
    c = sqlite3.connect(OB_DB, timeout=30)
    try:
        rows = c.execute("""SELECT ts, imbalance FROM orderbooks
                            WHERE symbol=? AND ts>=? AND ts<? ORDER BY ts""",
                         (sym_dash, start_ts, end_ts)).fetchall()
    finally:
        c.close()

    return {ts: obi for ts, obi in rows if obi is not None}

def rsi_at(c, idx, p=14):
    if idx < p+1: return 50.0
    d = np.diff(c[:idx+1]); g = np.where(d>0,d,0); l = np.where(d<0,-d,0)
    ag, al = np.mean(g[-p:]), np.mean(l[-p:])
    if al == 0: return 100.0
    return 100.0 - 100.0/(1.0 + ag/al)

def atr_pct(h, l, c, idx, p=14):
    if idx < p + 1: 
        return 0.0

    hh = h[:idx + 1]
    ll = l[:idx + 1]
    cc = c[:idx + 1]

    tr = []
    for i in range(1, len(hh)):
        tr_value = max(hh[i] - ll[i], 
                       abs(hh[i] - cc[i - 1]), 
                       abs(ll[i] - cc[i - 1]))
        tr.append(tr_value)

    atr = sum(tr[-p:]) / p if p > 0 else 0.0
    return float(atr / max(cc[-1], 1e-9))

def vwap_diff_pct(o, h, l, c, v, idx, p=20):
    if idx < p:
        return 0.0

    tp = [(h[i] + l[i] + c[i]) / 3.0 for i in range(idx - p + 1, idx + 1)]
    vv = v[idx - p + 1:idx + 1]
    s = sum(vv)

    if s == 0:
        return 0.0

    vwap = sum(tp[i] * vv[i] for i in range(len(tp))) / s
    return float((c[idx] - vwap) / max(vwap, 1e-9))

def rsi_at(prices, idx, period=14):
    if idx < period:
        return 0.0
    gain = 0.0
    loss = 0.0
    for i in range(1, period + 1):
        delta = prices[idx - i + 1] - prices[idx - i]
        if delta > 0:
            gain += delta
        else:
            loss -= delta
    avg_gain = gain / period
    avg_loss = loss / period
    if avg_loss == 0:
        return 100.0
    rs = avg_gain / avg_loss
    return 100 - (100 / (1 + rs))

def atr_pct(highs, lows, closes, idx, period=14):
    if idx < period:
        return 0.0
    tr_values = []
    for i in range(1, period + 1):
        high = highs[idx - i + 1]
        low = lows[idx - i + 1]
        close_prev = closes[idx - i]
        tr = max(high - low, abs(high - close_prev), abs(low - close_prev))
        tr_values.append(tr)
    atr = sum(tr_values) / period
    return atr / closes[idx] if closes[idx] != 0 else 0.0

def vwap_diff_pct(opens, highs, lows, closes, volumes, idx):
    if idx == 0:
        return 0.0
    total_volume = 0.0
    total_vwap = 0.0
    for i in range(idx + 1):
        volume = volumes[i]
        total_volume += volume
        typical_price = (opens[i] + highs[i] + lows[i] + closes[i]) / 4
        total_vwap += typical_price * volume
    vwap = total_vwap / total_volume if total_volume != 0 else 0.0
    return (closes[idx] - vwap) / vwap if vwap != 0 else 0.0

