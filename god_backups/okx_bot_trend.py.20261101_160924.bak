from datetime import datetime

LOG = 'logfile.log'  # Укажите путь к вашему файлу логов

def log(m):
    line = f'[{datetime.now():%H:%M:%S}] {m}'
    print(line, flush=True)
    with open(LOG, 'a') as f:
        f.write(line + '\n')

import sqlite3

DB = 'trades.db'

def init_db():
    c = sqlite3.connect(DB)
    c.execute("""CREATE TABLE IF NOT EXISTS trades (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        symbol TEXT NOT NULL, 
        side TEXT NOT NULL, 
        strategy TEXT NOT NULL,
        entry_price REAL NOT NULL, 
        exit_price REAL, 
        pnl REAL,
        entry_ts INTEGER NOT NULL, 
        exit_ts INTEGER,
        status TEXT DEFAULT 'OPEN', 
        win_flag INTEGER DEFAULT 0,
        tp REAL NOT NULL, 
        sl REAL NOT NULL, 
        timeout_bars INTEGER DEFAULT 4
    )""")
    c.commit()
    c.close()

import sqlite3

def get_candles(sym, tf='15m', limit=200):
    sym_db = sym.replace('-', '')
    c = sqlite3.connect(MARKET, timeout=10)

    rows = c.execute("SELECT ts,o,h,l,c,v FROM candles WHERE symbol=? AND tf=? ORDER BY ts DESC LIMIT ?",
                     (sym_db, tf, limit)).fetchall()
    c.close()

    if not rows: 
        return None

    rows = rows[::-1]  # Инвертируем порядок, чтобы получить данные в хронологическом порядке

    return {
        'ts': [r[0] for r in rows],
        'o': [r[1] for r in rows],
        'h': [r[2] for r in rows],
        'l': [r[3] for r in rows],
        'c': [r[4] for r in rows],
        'v': [r[5] for r in rows]
    }

def get_price(sym):
    d = get_candles(sym, '15m', 2)
    return float(d['c'][-1]) if d else None

def ema(values, period):
    """EMA."""
    if len(values) < period: return None
    alpha = 2.0 / (period + 1)
    ema_val = float(values[0])
    for v in values[1:]:
        ema_val = alpha * float(v) + (1 - alpha) * ema_val
    return ema_val

