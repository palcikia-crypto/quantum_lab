def ema(data, period):
    if len(data) < period:
        return None
    k = 2 / (period + 1)
    ema_values = [sum(data[:period]) / period]  # Начальное значение EMA
    for price in data[period:]:
        new_ema = (price - ema_values[-1]) * k + ema_values[-1]
        ema_values.append(new_ema)
    return ema_values[-1]

def check_trend_signal(sym):
    """TREND-FOLLOWING: EMA 20/50 cross + breakout."""
    data = get_candles(sym, '15m', 200)
    if not data or len(data['c']) < 60:
        return None

    cl = data['c']
    h = data['h']
    l = data['l']

    # EMA 20/50
    ema20 = ema(cl[-50:], 20)
    ema50 = ema(cl[-50:], 50)
    if ema20 is None or ema50 is None:
        return None

    # Тренд
    trend_up = ema20 > ema50
    trend_down = ema20 < ema50

    # Breakout: последние 20 свечей
    hh = max(h[-20:-1])  # high за 20, без последней
    ll = min(l[-20:-1])   # low за 20, без последней
    cur = float(cl[-1])
    entry = cur

    # LONG: тренд вверх + breakout вверх
    if trend_up and cur > hh:
        return ('LONG', entry)
    # SHORT: тренд вниз + breakout вниз
    if trend_down and cur < ll:
        return ('SHORT', entry)

    return None

