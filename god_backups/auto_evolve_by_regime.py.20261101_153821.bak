import random

def generate_mutants(base_strategy):
    mutants = {}

    for mutation in range(10):  # Генерация 10 мутантов
        mutant = base_strategy.copy()

        # Вносим изменения в стратегию
        if 'TP' in mutant:
            mutant['TP'] += random.uniform(-0.02, 0.02)  # Изменение Take Profit
        if 'SL' in mutant:
            mutant['SL'] += random.uniform(-0.01, 0.01)  # Изменение Stop Loss
        if 'ADX' in mutant:
            mutant['ADX'] += random.randint(-5, 5)  # Изменение ADX

        # Убедимся, что значения в разумных пределах
        mutant['TP'] = max(0, min(mutant['TP'], 0.1))  # Ограничиваем TP от 0 до 10%
        mutant['SL'] = max(0, min(mutant['SL'], 0.05))  # Ограничиваем SL от 0 до 5%
        mutant['ADX'] = max(0, mutant['ADX'])  # ADX не может быть отрицательным

        mutants[f'mutant_{mutation + 1}'] = mutant

    return mutants

# Пример базовой стратегии
base_strategy = {
    'TP': 0.02,
    'SL': 0.01,
    'ADX': 25
}

# Генерация мутантов
