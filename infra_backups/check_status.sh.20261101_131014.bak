#!/data/data/com.termux/files/usr/bin/bash
clear
echo "════════════════════════════════════════════════"
echo "  ДАШБОРД: $(date +%H:%M:%S)  |  $(date +%d.%m.%Y)"
echo "════════════════════════════════════════════════"
echo ""
echo "=== БОТЫ ==="
echo "v3:           $(pgrep -f okx_bot_paper_v3 > /dev/null && echo OK || echo FAIL)"
echo "oracle:       $(pgrep -f 'oracle.py loop' > /dev/null && echo OK || echo FAIL)"
echo "RSI-bot:      $(pgrep -f rsi_bot > /dev/null && echo OK || echo FAIL)"
echo "GOD v4:       $(pgrep -f god_agent_v4 > /dev/null && echo OK || echo FAIL)"
echo ""
echo "=== ИИ-ЛАБОРАТОРИЯ ==="
echo "Процесс:  $(pgrep -f strategy_lab > /dev/null && echo OK || echo FAIL)"
if [ -f /data/data/com.termux/files/home/quantum_lab_sandbox/GOLDEN_AI.json ]; then
    python3 -c "import json; d=json.load(open('/data/data/com.termux/files/home/quantum_lab_sandbox/GOLDEN_AI.json')); print('Рекорд:   ' + str(d.get('pnl', '?')))"
else
    echo "Рекорд:   нет файла"
fi
echo "Итераций: $(grep -c ИТЕРАЦИЯ /data/data/com.termux/files/home/quantum_lab_sandbox/.strategy_lab.log 2>/dev/null || echo 0)"
echo ""
echo "=== PnL v3 ==="
echo -n "Всего: "
sqlite3 /data/data/com.termux/files/home/quantum_lab/data/okx_paper_v3.db "SELECT COUNT(*) || ' сделок, PnL=' || ROUND(COALESCE(SUM(pnl),0),2) FROM trades WHERE status='CLOSED';" 2>/dev/null
echo -n "Открыто: "
sqlite3 /data/data/com.termux/files/home/quantum_lab/data/okx_paper_v3.db "SELECT COUNT(*) FROM trades WHERE status='OPEN';" 2>/dev/null
echo ""
echo "=== СИСТЕМА ==="
free -h | awk 'NR==2{print "RAM: " $3 "/" $2 " (avail " $7 ")"}'
free -h | awk 'NR==3{print "Swap: " $3 "/" $2}'
echo ""
