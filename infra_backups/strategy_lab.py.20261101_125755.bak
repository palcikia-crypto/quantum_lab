import sys, os, subprocess, time, re, json, ast, textwrap
from pathlib import Path
sys.path.append(str(Path.home() / "quantum_lab_sandbox" / "tools" / "agent_dev"))
from llm_backend import ask

SANDBOX = Path.home() / "quantum_lab_sandbox"
TEST_FILE = SANDBOX / "tools" / "backtester_ai_test.py"
GOLDEN_FILE = SANDBOX / "GOLDEN_AI.json"
HISTORY_FILE = SANDBOX / "indicator_history.json"
LOG = SANDBOX / ".strategy_lab.log"

INDICATORS = ["RSI", "MACD", "BOLLINGER", "OBV", "WILLIAMS", "ROC"]

TEMPLATE = """import sqlite3

FEE = 0.001
LIMIT = 1000

{INDICATOR}

def fetch(conn, sym):
    cur = conn.cursor()
    cur.execute("SELECT ts, o, h, l, c, v FROM candles WHERE symbol=? AND tf=? ORDER BY ts DESC LIMIT ?", (sym, "4h", LIMIT))
    return cur.fetchall()[::-1]

def bt(conn, sym):
    cs = fetch(conn, sym)
    if len(cs) < 30: return 0.0
    closes = [r[4] for r in cs]
    ind = my_indicator(closes)
    
    if not isinstance(ind, (list, tuple)):
        ind = [ind] * len(closes)
    
    if len(ind) < len(cs):
        ind = [None] * (len(cs) - len(ind)) + list(ind)
    elif len(ind) > len(cs):
        ind = list(ind)[-len(cs):]
    
    pos = 0
    entry = 0.0
    trades = []
    
    for i in range(1, len(cs)):
        if ind[i] is None or ind[i-1] is None: continue
        ind_cur, ind_prev = ind[i], ind[i-1]
        prev_c, cur_c = closes[i-1], closes[i]
        high, low = cs[i][2], cs[i][3]
        
{SIGNAL}
        
        if pos == 1:
            if high >= entry * 1.02: trades.append(0.02 - FEE*2); pos = 0
            elif low <= entry * 0.99: trades.append(-0.01 - FEE*2); pos = 0
        elif pos == -1:
            if low <= entry * 0.98: trades.append(0.02 - FEE*2); pos = 0
            elif high >= entry * 1.01: trades.append(-0.01 - FEE*2); pos = 0
    
    return sum(trades)

def main():
    conn = sqlite3.connect("data/market.db")
    total = 0.0
    for s in ["BTCUSDT","ETHUSDT","SOLUSDT","DOGEUSDT","XRPUSDT"]:
        total += bt(conn, s)
    print(f"ИТОГО: {total}")
    conn.close()

if __name__ == "__main__":
    main()
"""

def log(msg):
    ts = time.strftime("%H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line, flush=True)
    with open(LOG, "a") as f: f.write(line + "\n")

def load_history():
    if HISTORY_FILE.exists():
        try: return json.loads(HISTORY_FILE.read_text())
        except: pass
    return []

def save_history(h):
    HISTORY_FILE.write_text(json.dumps(h, indent=2))

def detect_indicator(code):
    c = code.lower()
    for kw, name in [("rsi", "RSI"), ("macd", "MACD"), ("stoch", "STOCHASTIC"),
                     ("bollinger", "BOLLINGER"), ("cci", "CCI"), ("williams", "WILLIAMS"),
                     ("obv", "OBV"), ("roc", "ROC"), ("ema", "EMA"), ("sma", "SMA")]:
        if kw in c: return name
    return "UNKNOWN"

def build_indicator_prompt(history):
    tried = ", ".join(history) if history else "ничего"
    return f"""Напиши функцию my_indicator(prices) на Python.
Доступны ТОЛЬКО цены закрытия (prices).

ПРИМЕР ПРАВИЛЬНОГО КОДА (для RSI):
def my_indicator(prices):
    result = [None] * len(prices)
    n = 14
    if len(prices) < n:
        return result
    gains = []
    losses = []
    for i in range(1, len(prices)):
        ch = prices[i] - prices[i-1]
        if ch > 0:
            gains.append(ch)
            losses.append(0)
        else:
            gains.append(0)
            losses.append(-ch)
        if i >= n:
            avg_g = sum(gains[-n:]) / n
            avg_l = sum(losses[-n:]) / n
            if avg_l == 0:
                result[i] = 100
            else:
                rs = avg_g / avg_l
                result[i] = 100 - (100 / (1 + rs))
    return result

УЖЕ ПРОБОВАЛ: {tried}
ВЫБЕРИ НОВЫЙ из: MACD, Bollinger, Stochastic, CCI, Williams, OBV, ROC, EMA, SMA.

ВАЖНО:
- Если тебе нужна вспомогательная функция — ОПРЕДЕЛИ ЕЁ ЧЕРЕЗ def ВНУТРИ my_indicator.
- НЕ ИСПОЛЬЗУЙ готовые имена вроде CCI(), SMA(), EMA() без определения.
- Все вычисления пиши вручную.

ТОЛЬКО код функции."""

def is_valid(code):
    try:
        ast.parse(code)
        return True, ""
    except Exception as e:
        return False, str(e)

def ask_clean(prompt, error_ctx=None, prev_code=None):
    full = prompt
    if error_ctx:
        full += "\n\n"
        if prev_code: full += "ТВОЙ СЛОМАННЫЙ КОД:\n" + prev_code + "\n\n"
        full += "ОШИБКА:\n" + error_ctx + "\n\nИСПРАВЬ ЭТОТ КОД."
    for a in range(2):
        try:
            r = ask(full, system_prompt="Пиши ТОЛЬКО код на чистом Python. Без numpy, pandas.").strip()
            r = r.replace("```python", "").replace("```", "").strip()
            if not r: continue
            if any(x in r for x in ["numpy", "pandas", "talib"]): continue
            r = textwrap.dedent(r).strip()
            ok, err = is_valid(r)
            if ok: return r
            log("   AST: " + err[:60])
        except Exception as e:
            log("   " + str(e))
        time.sleep(3)
    return None

def get_pnl(out):
    for line in out.split("\n"):
        if "ИТОГО" in line:
            nums = re.findall(r"-?\d+\.?\d*", line)
            if nums:
                try: return float(nums[-1])
                except: pass
    return -99999.0

def main():
    log("🚀 LAB v9: Автономный поиск (рабочая версия)")
    
    best_pnl = -13229.76
    if GOLDEN_FILE.exists():
        try:
            d = json.loads(GOLDEN_FILE.read_text())
            best_pnl = d.get("pnl", best_pnl)
        except: pass
    log(f"📊 Стартовый PnL: {best_pnl}")
    
    history = load_history()
    log(f"📚 История: {', '.join(history) if history else 'пусто'}")
    
    iteration = 0
    while True:
        iteration += 1
        log(f"\n--- ИТЕРАЦИЯ {iteration} ---")
        
        if len(history) >= len(INDICATORS):
            log("📚 Все индикаторы попробованы. Сброс истории.")
            history = []
            save_history(history)
        
        log("🤖 Генерирую индикатор...")
        ind_func = ask_clean(build_indicator_prompt(history))
        if not ind_func or "def my_indicator" not in ind_func:
            time.sleep(30); continue
        
        detected = detect_indicator(ind_func)
        log(f"🎯 ИИ выбрал: {detected}")
        if detected not in history and detected != "UNKNOWN":
            history.append(detected)
            save_history(history)
        
        log(f"🤖 Генерирую сигнал для {detected}...")
        signal_prompt = f"""Напиши ТОЛЬКО условие входа (if/elif), 3-5 строк.
Переменные: i, prev_c, cur_c, ind_prev, ind_cur, pos, entry.
Индикатор: {detected}
КРИТИЧЕСКИ ВАЖНО: Вход ТОЛЬКО если pos == 0!
if pos == 0 and <условие LONG>:
    pos = 1
    entry = cur_c
elif pos == 0 and <условие SHORT>:
    pos = -1
    entry = cur_c
ТОЛЬКО эти строки."""
        
        signal = ask_clean(signal_prompt)
        if not signal:
            time.sleep(30); continue
        
        for fix_attempt in range(3):
            signal_indented = textwrap.indent(signal, "        ")
            code = TEMPLATE.replace("{INDICATOR}", ind_func).replace("{SIGNAL}", signal_indented)
            
            ok, err = is_valid(code)
            if not ok:
                log(f"⚠️ AST, фикс {fix_attempt+1}/3")
                ind_func = ask_clean(build_indicator_prompt(history), error_ctx="AST: " + err, prev_code=ind_func)
                if not ind_func: break
                continue
            
            TEST_FILE.write_text(code)
            log(f"🧪 Тест {fix_attempt+1}/3...")
            r = subprocess.run(["python3", str(TEST_FILE)], cwd=SANDBOX, capture_output=True, text=True, timeout=60)
            out = r.stdout + r.stderr
            pnl = get_pnl(out)
            
            if pnl != -99999.0 and "Error" not in out and "Traceback" not in out:
                if pnl > best_pnl:
                    log(f"🏆 РЕКОРД! PnL: {pnl} (было {best_pnl}) [{detected}]")
                    best_pnl = pnl
                    GOLDEN_FILE.write_text(json.dumps({"iter": iteration, "pnl": pnl, "indicator": detected, "history": history, "full_code": code}, indent=2))
                    log("💾 Сохранено")
                else:
                    log(f"📉 PnL {pnl} <= {best_pnl}. Откат.")
                break
            else:
                err_short = "\n".join(out.split("\n")[-15:])
                log(f"⚠️ {err_short[-80:]}")
                ind_func = ask_clean(build_indicator_prompt(history), error_ctx=err_short, prev_code=ind_func)
                if not ind_func: break
        
        log("💤 Пауза 30с...")
        time.sleep(30)

if __name__ == "__main__":
    main()
